# Backend Configuration
PORT=3001

# Agent Execution Mode: 'direct' (default), 'http' (calls Python server), 'subprocess' (local dev)
AGENT_MODE=direct

# Agent Server URL (only needed when AGENT_MODE=http)
AGENT_SERVER_URL=https://orca-dojo-agents-xxxxx.herokuapp.com

# Database (Supabase PostgreSQL — Heroku sets DATABASE_URL automatically if using Heroku Postgres)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Algorand Network
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.algonode.cloud

# Admin Account (DO NOT commit real mnemonic)
ADMIN_ADDRESS=YOUR_ADMIN_ADDRESS
ADMIN_MNEMONIC=your twenty five word mnemonic goes here

# API Keys
GROQ_API_KEY=gsk_YOUR_GROQ_KEY
KITE_API_KEY=YOUR_KITE_KEY

# Contract App IDs (Algorand TestNet)
DOJO_REGISTRY_APP_ID=758815322
ESCROW_VAULT_APP_ID=761941677
COMMITMENT_LOCK_APP_ID=761941684
PAYOUT_SPLITTER_APP_ID=758815334
USDC_ASSET_ID=10458941

# Security
VAULT_KEY=your_64_char_hex_vault_key_here
JWT_SECRET=your_jwt_secret_here

# Treasury
TREASURY_ADDRESS=YOUR_TREASURY_ADDRESS

# x402 Payment Protocol
AVM_PRIVATE_KEY=your_base64_private_key
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
PAY_TO=YOUR_PAYMENT_RECEIVING_ADDRESS
